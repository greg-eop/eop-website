{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "overview": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "services": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clientProblem": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "faqs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer"
        ]
      }
    },
    "order": {
      "default": 100,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "showCta": {
      "default": false,
      "type": "boolean"
    },
    "ctaDescription": {
      "type": "string"
    },
    "ctaText": {
      "type": "string"
    },
    "ctaHref": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description"
  ]
}