---
import '../styles/globals.css';
import firmInfo from '../data/firm-info.json';
import defaultOgImage from '../images/courthouse-panel.webp';
import JsonLd from '../components/astro/JsonLd.astro';
import {
  buildJsonLdGraph,
  absoluteUrl,
  type Breadcrumb,
  type JsonLdNode,
} from '../lib/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  pageType?: string;
  breadcrumbLabel?: string;
  breadcrumbs?: Breadcrumb[];
  schema?: JsonLdNode | JsonLdNode[] | null;
}

const {
  title,
  description,
  image,
  noindex = false,
  pageType,
  breadcrumbLabel,
  breadcrumbs,
  schema,
} = Astro.props;

const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, site);
canonicalURL.search = '';
canonicalURL.hash = '';

const ogImageSrc = image || defaultOgImage.src;
const ogImageURL = new URL(ogImageSrc, site);
const siteName = firmInfo.firmName;
const jsonLd = buildJsonLdGraph({
  site,
  pathname: Astro.url.pathname,
  title,
  description,
  pageType,
  breadcrumbLabel,
  breadcrumbs,
  extra: schema,
  organization: {
    name: firmInfo.firmName,
    description: firmInfo.summary,
    telephone: firmInfo.phone,
    email: firmInfo.email,
    fax: firmInfo.fax,
    addressLines: firmInfo.addressLines,
    mapUrl: firmInfo.mapUrl,
    sameAs: firmInfo.socialLinks.map((link) => link.href),
    logoUrl: absoluteUrl(site, '/images/logo.webp'),
    imageUrl: ogImageURL.href,
  },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <JsonLd data={jsonLd} />

    <script is:inline>
      (function () {
        var path = window.location.pathname.replace(/\/+$/, '') || '/';
        if (path !== '/practice-areas') return;

        var hashMap = {
          'section-1': '/practice-areas/business-finance',
          'section-2': '/practice-areas/employment',
          'section-3': '/practice-areas/tax-estate-planning',
          'section-4': '/practice-areas/intellectual-property',
          'section-5': '/practice-areas/intellectual-property',
          'section-6': '/practice-areas/litigation-appellate-practices',
          'section-7': '/practice-areas/insurance',
          'section-8': '/practice-areas/affordable-housing-development-financing',
        };
        var key = (window.location.hash || '').replace(/^#/, '');
        var dest = hashMap[key];
        if (dest) window.location.replace(dest);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (event) => {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;

          const target = document.querySelector(href);
          if (!target) return;

          event.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    </script>

    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-motion]');

        if (typeof IntersectionObserver === 'undefined') {
          return;
        }

        // Hide elements immediately so they don't flash at full opacity before
        // the observer fires and the animation starts.
        els.forEach(function (el) {
          el.style.opacity = '0';
        });

        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var el = entry.target;
            var delay = el.getAttribute('data-motion-delay');
            if (delay) el.style.animationDelay = delay + 'ms';
            // Clear the inline opacity so the animation's 0%→natural fade works.
            el.style.opacity = '';
            var classes = (el.getAttribute('data-motion') || '').split(' ').filter(Boolean);
            el.classList.add.apply(el.classList, classes);
            observer.unobserve(el);
          });
        }, { rootMargin: '0px 0px 150px 0px', threshold: 0 });

        els.forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
