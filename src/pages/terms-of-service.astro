---
import CmsDocument from '../components/astro/CmsDocument.astro';
import data from '../data/terms-of-service.json';
import firmInfo from '../data/firm-info.json';
import { interpolate } from '../lib/interpolate';

const vars = { phone: firmInfo.phone };
---

<CmsDocument
  title={interpolate(data.meta.title, vars)}
  description={interpolate(data.meta.description, vars)}
  heading={data.heading}
  lastUpdated={data.lastUpdated}
  body={interpolate(data.body, vars)}
/>
