---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import PageHero from '../components/astro/PageHero.astro';
import page from '../data/home.json';
import practiceAreasPage from '../data/practice-areas-page.json';
import firmInfo from '../data/firm-info.json';
import { getCollection } from 'astro:content';
import courthousePanelImg from '../images/courthouse-panel.webp';
import { absoluteUrl, itemListNode } from '../lib/schema';

interface ListingArea {
  title: string;
  slug: string;
  summary: string;
}

const listingAreas: ListingArea[] = (await getCollection('practiceAreas'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map((entry) => ({
    title: entry.data.title,
    slug: entry.id,
    summary: entry.data.description,
  }));

const site = Astro.site ?? Astro.url;
const practiceAreaList = itemListNode({
  id: absoluteUrl(site, '/practice-areas#practice-areas'),
  name: practiceAreasPage.hero.title,
  items: listingAreas.map((area) => ({
    name: area.title,
    url: absoluteUrl(site, `/practice-areas/${area.slug}`),
  })),
});
---

<BaseLayout
  title={practiceAreasPage.meta.title}
  description={practiceAreasPage.meta.description}
  schema={practiceAreaList}
>
  <div class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 bg-white">
      <PageHero
        title={practiceAreasPage.hero.title}
        subtitle={practiceAreasPage.hero.subtitle}
        backgroundImageSrc={courthousePanelImg.src}
        containerMaxWidthClass="max-w-5xl"
      />

      <section id="practice" class="mx-auto w-full max-w-5xl px-6 py-12 md:py-16">
        <div class="max-w-4xl text-neutral-700">
          <p class="leading-relaxed">
            {practiceAreasPage.intro}
          </p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {listingAreas.map((area) => (
            <article class="rounded-sm border border-border bg-white p-8 shadow-sm transition-shadow hover:shadow-md">
              <h2 class="font-serif text-2xl text-primary">{area.title}</h2>
              <p class="mt-4 leading-relaxed text-neutral-700">{area.summary}</p>
              <a
                href={`/practice-areas/${area.slug}`}
                class="mt-6 inline-flex items-center text-primary underline decoration-accent underline-offset-4 transition-colors hover:text-accent"
              >
                {practiceAreasPage.viewPracticeArea}
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>
    <Footer
      summary={firmInfo.summary}
      practiceLinks={page.footer.practiceLinks}
      companyLinks={page.footer.companyLinks}
      legalLinks={page.footer.legalLinks}
      socialLinks={firmInfo.socialLinks}
      copyright={firmInfo.copyright}
      phone={firmInfo.phone}
      addressLines={firmInfo.addressLines}
    />
  </div>
</BaseLayout>
