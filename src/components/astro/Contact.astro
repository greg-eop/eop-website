---
import { getCollection } from 'astro:content';
import firmInfo from '../../data/firm-info.json';
import contact from '../../data/contact.json';
import {
  buildInquiryRouting,
  buildPracticeAreaRoutes,
  formsparkEndpoint,
} from '../../lib/practice-area-routing';

const practiceAreas = (await getCollection('practiceAreas'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const attorneys = await getCollection('attorneys');
const otherIntakeFormsparkIds = firmInfo.otherIntakeFormsparkIds ?? [];
const practiceAreaRoutes = buildPracticeAreaRoutes(practiceAreas, attorneys);
const routingById = buildInquiryRouting(practiceAreas, attorneys, otherIntakeFormsparkIds);
const defaultFormId = routingById.other?.formIds[0];

const { heading, description, form } = contact;
const phone = firmInfo.phone;
const email = firmInfo.email;
const addressLines = firmInfo.addressLines;
const officeHours = firmInfo.officeHours;
const mapUrl = firmInfo.mapUrl;
const parkingInfo = firmInfo.parkingInfo;
const successBodyParts = form.successBody.split('{phone}');
---

<section id="contact" class="py-32 bg-background">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-16">
      <div>

        <h2 class="text-4xl md:text-6xl text-primary mb-8">{heading}</h2>

        <p class="text-lg text-muted-foreground mb-12 leading-relaxed">{description}</p>

        <div class="space-y-8">
          <div class="flex items-start gap-4">
            <div class="w-14 h-24 text-lg bg-accent/10 flex items-center justify-center flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.54a16 16 0 0 0 6.29 6.29l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
            <div>
              <h4 class="text-xl text-primary mb-2">{form.phoneLabel}</h4>
              <p class="text-muted-foreground">
                <a class="hover:text-accent underline underline-offset-4 transition-colors decoration-accent" href={`tel:${phone}`}>{phone}</a>
              </p>
            </div>
          </div>

          <!-- <div class="flex items-start gap-4">
            <div class="w-14 h-24 text-lg bg-accent/10 flex items-center justify-center flex-shrink-0">✉</div>
            <div>
              <h4 class="text-xl text-primary mb-2">Email</h4>
              <p class="text-muted-foreground">
                <a class="hover:text-accent underline underline-offset-4 transition-colors decoration-accent" href={`mailto:${email}`}>{email}</a>
              </p>
            </div>
          </div> -->

          <div class="flex items-start gap-4">
            <div class="w-14 h-24 text-lg bg-accent/10 flex items-center justify-center flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
            <div>
              <h4 class="text-xl text-primary mb-2">{form.addressLabel}</h4>
              {mapUrl ? (
                <a
                  href={mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted-foreground hover:text-accent underline underline-offset-4 transition-colors decoration-accent"
                >
                  {addressLines[0]}<br />{addressLines[1]}
                </a>
              ) : (
                <p class="text-muted-foreground">{addressLines[0]}<br />{addressLines[1]}</p>
              )}
              {parkingInfo && (
                <p class="mt-2 text-sm text-muted-foreground italic">{parkingInfo}</p>
              )}
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-14 h-24 text-lg bg-accent/10 flex items-center justify-center flex-shrink-0">◷</div>
            <div>
              <h4 class="text-xl text-primary mb-2">{form.hoursLabel}</h4>
              <p class="text-muted-foreground">
                {officeHours.filter(Boolean).map((line, index) => (
                  <>
                    {index > 0 && <br />}
                    {line}
                  </>
                ))}
              </p>
            </div>
          </div>
        </div>

        <iframe
          title={form.mapTitle}
          src="https://maps.google.com/maps?q=707+SW+Washington+St+Suite+1500,Portland,OR+97205&t=&z=16&ie=UTF8&iwloc=&output=embed"
          width="100%"
          height="280"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full mt-8"
        ></iframe>
      </div>

      <div class="bg-accent/50 p-12">
        <h3 class="text-3xl mb-8">{form.heading}</h3>

        <div
          id="contact-success"
          class="hidden border border-primary/10 bg-white px-6 py-8"
          role="status"
        >
          <p class="text-xl text-primary mb-3">{form.successTitle}</p>
          <p class="text-muted-foreground leading-relaxed">
            {successBodyParts[0]}
            {successBodyParts.length > 1 && (
              <a class="underline underline-offset-4 decoration-accent hover:text-accent" href={`tel:${phone}`}>{phone}</a>
            )}
            {successBodyParts[1]}
          </p>
        </div>

        <form
          id="contact-form"
          class="relative space-y-6"
          action={defaultFormId ? formsparkEndpoint(defaultFormId) : undefined}
          method="POST"
          data-fallback-email={email}
          data-routing={JSON.stringify(routingById)}
          data-submit-label={form.submit}
          data-sending-label={form.sending}
          data-routing-named={form.routingNamed}
          data-routing-intake={form.routingIntake}
        >
          <input type="hidden" name="_email.subject" id="email-subject" value="Website inquiry" />
          <input type="hidden" name="assigned_attorneys" id="assigned-attorneys" value={`Firm intake (${email})`} />

          <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
            <label for="company-website">{form.honeypotLabel}</label>
            <input type="text" id="company-website" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label for="name" class="block mb-2">{form.nameLabel}</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              maxlength="120"
              autocomplete="name"
              class="w-full px-6 py-4 border placeholder focus:outline-none focus:border-accent bg-white"
              placeholder={form.namePlaceholder}
            />
          </div>

          <div>
            <label for="email" class="block mb-2">{form.emailLabel}</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              maxlength="120"
              autocomplete="email"
              class="w-full px-6 py-4 border placeholder focus:outline-none focus:border-accent bg-white"
              placeholder={form.emailPlaceholder}
            />
          </div>

          <div>
            <label for="phone" class="block mb-2">{form.phoneFieldLabel}</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              maxlength="40"
              autocomplete="tel"
              class="w-full px-6 py-4 border placeholder focus:outline-none focus:border-accent bg-white"
              placeholder={form.phonePlaceholder}
            />
          </div>

          <div>
            <label for="case-type" class="block mb-2">{form.practiceAreaLabel}</label>
            <select
              id="case-type"
              name="practice_area"
              required
              class="w-full px-6 py-4 border focus:outline-none focus:border-accent bg-white"
            >
              <option value="" disabled selected>{form.selectPlaceholder}</option>
              {practiceAreaRoutes.map((area) => (
                <option value={area.title} data-area-id={area.id}>
                  {area.title}
                </option>
              ))}
              <option value={form.otherOption} data-area-id="other">{form.otherOption}</option>
            </select>
            <p id="routing-note" class="mt-2 text-sm text-muted-foreground min-h-5" aria-live="polite"></p>
          </div>

          <div>
            <label for="message" class="block mb-2">{form.messageLabel}</label>
            <textarea
              id="message"
              name="message"
              rows={5}
              required
              minlength="10"
              maxlength="5000"
              class="w-full px-6 py-4 border placeholder focus:outline-none focus:border-accent bg-white resize-none"
              placeholder={form.messagePlaceholder}
            ></textarea>
          </div>

          <p
            id="contact-error"
            class="hidden text-sm text-destructive"
            role="alert"
          >
            {form.error}
          </p>

          <button
            type="submit"
            id="contact-submit"
            class="w-full px-8 py-5 bg-accent text-accent-foreground hover:bg-white transition-colors disabled:opacity-60 disabled:pointer-events-none"
          >
            {form.submit}
          </button>

          <p class="text-xs text-muted-foreground leading-relaxed">
            {form.disclaimer}
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const successEl = document.getElementById('contact-success');
  const errorEl = document.getElementById('contact-error');
  const submitBtn = document.getElementById('contact-submit');
  const practiceSelect = document.getElementById('case-type');
  const assignedInput = document.getElementById('assigned-attorneys');
  const subjectInput = document.getElementById('email-subject');
  const routingNote = document.getElementById('routing-note');

  if (
    form instanceof HTMLFormElement &&
    successEl &&
    errorEl &&
    submitBtn instanceof HTMLButtonElement &&
    practiceSelect instanceof HTMLSelectElement &&
    assignedInput instanceof HTMLInputElement &&
    subjectInput instanceof HTMLInputElement &&
    routingNote
  ) {
    const fallbackEmail = form.dataset.fallbackEmail || 'attorneys@eoplaw.com';
    const formsparkOrigin = 'https://submit-form.com';
    /** @type {Record<string, { id: string, title: string, formIds: string[], attorneys: { name: string, email: string }[] }>} */
    const routingById = JSON.parse(form.dataset.routing || '{}');

    const formatAssigned = (attorneys) => {
      if (!attorneys || attorneys.length === 0) {
        return `Firm intake (${fallbackEmail})`;
      }
      return attorneys
        .map((attorney) => `${attorney.name} (${attorney.email})`)
        .join(', ');
    };

    const selectedAreaId = () =>
      practiceSelect.selectedOptions[0]?.dataset.areaId || '';

    const selectedRoute = () => routingById[selectedAreaId()] || null;

    const formIdsForRoute = (route) =>
      [...new Set((route?.formIds || []).filter(Boolean))];

    const updateRouting = () => {
      const areaId = selectedAreaId();
      const route = selectedRoute();
      const title = practiceSelect.value || 'Website inquiry';
      assignedInput.value = formatAssigned(route?.attorneys);
      subjectInput.value = `Website inquiry: ${title}`;

      const formIds = formIdsForRoute(route);
      if (formIds[0]) {
        form.action = `${formsparkOrigin}/${formIds[0]}`;
      }

      if (route?.attorneys?.length) {
        const names = route.attorneys.map((attorney) => attorney.name);
        const last = names[names.length - 1];
        const label =
          names.length === 1 ? names[0] : `${names.slice(0, -1).join(', ')} and ${last}`;
        routingNote.textContent = (form.dataset.routingNamed || '').replace('{names}', label);
      } else if (areaId) {
        routingNote.textContent = form.dataset.routingIntake || '';
      } else {
        routingNote.textContent = '';
      }
    };

    const preselectFromQuery = () => {
      const requested = new URLSearchParams(window.location.search).get('practice-area');
      if (!requested) return;
      const match = Array.from(practiceSelect.options).find(
        (option) => option.dataset.areaId === requested,
      );
      if (!match) return;
      practiceSelect.value = match.value;
    };

    const sanitizeFromName = (value) =>
      value.replace(/[^a-zA-Z0-9 _-]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 80) ||
      'Website inquiry';

    preselectFromQuery();
    updateRouting();
    practiceSelect.addEventListener('change', updateRouting);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorEl.classList.add('hidden');

      const honeypot = form.querySelector('#company-website');
      if (honeypot instanceof HTMLInputElement && honeypot.value) {
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
        return;
      }

      updateRouting();

      const name = form.elements.namedItem('name');
      const emailField = form.elements.namedItem('email');
      const phoneField = form.elements.namedItem('phone');
      const messageField = form.elements.namedItem('message');

      if (
        !(name instanceof HTMLInputElement) ||
        !(emailField instanceof HTMLInputElement) ||
        !(phoneField instanceof HTMLInputElement) ||
        !(messageField instanceof HTMLTextAreaElement)
      ) {
        return;
      }

      const payload = {
        name: name.value.trim(),
        email: emailField.value.trim(),
        phone: phoneField.value.trim(),
        practice_area: practiceSelect.value,
        assigned_attorneys: assignedInput.value,
        message: messageField.value.trim(),
        _gotcha: '',
        _email: {
          from: sanitizeFromName(name.value),
          subject: subjectInput.value,
        },
      };

      const formIds = formIdsForRoute(selectedRoute());
      if (formIds.length === 0) {
        errorEl.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = form.dataset.sendingLabel || form.dataset.submitLabel || '';

      try {
        const responses = await Promise.all(
          formIds.map((formId) =>
            fetch(`${formsparkOrigin}/${formId}`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify(payload),
            }),
          ),
        );

        if (responses.some((response) => !response.ok)) {
          throw new Error('Formspark rejected a routed submission');
        }

        form.classList.add('hidden');
        successEl.classList.remove('hidden');
      } catch {
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = form.dataset.submitLabel || '';
      }
    });
  }
</script>
