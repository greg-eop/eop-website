---
interface Step {
  title: string;
  description: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  steps: Step[];
}

const { eyebrow, heading, description, steps } = Astro.props;
---

<section class="py-8 md:py-16 lg:py-32 bg-background">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div data-motion="motion-preset-slide-right motion-duration-700">
        <div class="inline-block px-6 py-2 bg-accent/10 border border-accent/30 mb-8">
          <span class="text-accent-foreground">{eyebrow}</span>
        </div>

        <h2 class="text-4xl md:text-6xl text-primary mb-8">{heading}</h2>

        <p class="text-lg text-muted-foreground mb-8 leading-relaxed">{description}</p>

        <div class="space-y-6">
          {steps.map((step, index) => (
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-accent flex items-center justify-center flex-shrink-0 text-accent-foreground text-xl">
                {index + 1}
              </div>
              <div>
                <h4 class="text-xl text-primary mb-2">{step.title}</h4>
                <p class="text-muted-foreground">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div data-motion="motion-preset-slide-left motion-duration-700" class="hidden lg:block relative h-[600px] lg:h-[700px] order-first lg:order-last">
        <img
          src="/images/process-handshake.jpg"
          alt="Business handshake"
          class="w-full h-full object-cover"
        />
        <div class="absolute -top-8 -left-8 w-64 h-64 bg-accent/20 border-4 border-accent"></div>
      </div>
    </div>
  </div>
</section>
