---
import { renderMarkdown } from '../../lib/markdown';

interface Props {
  content: string;
  class?: string;
}

const { content, class: className = '' } = Astro.props;
const html = renderMarkdown(content);
---

<div class:list={['cms-markdown', className]} set:html={html} />

<style>
  .cms-markdown :global(h2) {
    font-family: var(--site-font-serif), "Playfair Display", serif;
    font-size: 1.5rem;
    color: var(--primary);
    margin-bottom: 0.75rem;
    margin-top: 2rem;
  }
  .cms-markdown :global(h2:first-child) {
    margin-top: 0;
  }
  .cms-markdown :global(p),
  .cms-markdown :global(li) {
    line-height: 1.625;
    color: #404040;
  }
  .cms-markdown :global(p + p) {
    margin-top: 1.5rem;
  }
  .cms-markdown :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .cms-markdown :global(ul > li + li) {
    margin-top: 0.5rem;
  }
  .cms-markdown :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
</style>
