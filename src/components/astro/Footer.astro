---
import LogoWhite from "../../images/logo-white.svg";
import LinkedInLogo from "../../images/linkedin-logo.png";
import firmInfo from "../../data/firm-info.json";

interface CompanyLink {
  label: string;
  href: string;
}

interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  summary?: string;
  practiceLinks: CompanyLink[];
  companyLinks: CompanyLink[];
  legalLinks: CompanyLink[];
  socialLinks?: Array<string | SocialLink>;
  copyright?: string;
  phone?: string;
  addressLines?: string[];
}

const {
  summary,
  practiceLinks,
  companyLinks,
  legalLinks,
  socialLinks,
  copyright,
  phone,
  addressLines,
} = Astro.props;

const normalizeSocialLink = (item: string | SocialLink): SocialLink =>
  typeof item === "string"
    ? { label: item, href: "#" }
    : { label: item.label, href: item.href || "#" };

const displayedSummary = firmInfo.summary || summary || "";
const displayedPhone = firmInfo.phone || phone || "";
const displayedMapUrl = firmInfo.mapUrl || "";
const displayedPhoneHref = displayedPhone ? `tel:${displayedPhone.replace(/[^+\d]/g, "")}` : "#";
const displayedAddressLines =
  Array.isArray(firmInfo.addressLines) && firmInfo.addressLines.length > 0
    ? firmInfo.addressLines
    : addressLines || [];
const displayedCopyright = firmInfo.copyright || copyright || "";
const displayedSocialLinks: SocialLink[] =
  Array.isArray(firmInfo.socialLinks) && firmInfo.socialLinks.length > 0
    ? firmInfo.socialLinks
    : (socialLinks || []).map(normalizeSocialLink);

const isExternalUrl = (href: string) => /^https?:\/\//i.test(href);

const footerOnlyLinks = [
  { label: "Accessibility", href: "/accessibility" },
  { label: "Legal Notice & Disclaimer", href: "/legal-notice" },
];

---

<footer class="bg-primary text-white py-16">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid md:grid-cols-5 gap-12 mb-12">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <LogoWhite
            class="h-10 w-auto"
            role="img"
            aria-label="Elliott Ostrander & Preston, PC"
          />
        </div>
        <p class="text-white/70 mb-6">{displayedSummary}</p>

        <div class="space-y-3">
          <div class="flex items-start gap-2 text-white/70">
            <span class="mt-1 flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <a
              href={displayedMapUrl || "#"}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm hover:text-accent transition-colors"
            >
              {
                displayedAddressLines.map((line, index) => (
                  <>
                    {index > 0 && <br />}
                    {line}
                  </>
                ))
              }
            </a>
          </div>
          <div class="flex items-center gap-2 text-white/70">
            <span class="flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.54a16 16 0 0 0 6.29 6.29l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
            <a href={displayedPhoneHref} class="text-sm hover:text-accent transition-colors">
              {displayedPhone}
            </a>
          </div>
        </div>
      </div>

      <div>
        <h4 class="text-lg mb-4">Practice Areas</h4>
        <ul class="space-y-2 text-white/70">
          {
            practiceLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:text-accent transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="text-lg mb-4">Company</h4>
        <ul class="space-y-2 text-white/70">
          {
            companyLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:text-accent transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="text-lg mb-4">Legal</h4>
        <ul class="space-y-2 text-white/70">
          {
            footerOnlyLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:text-accent transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="text-lg mb-4">More</h4>
        <ul class="space-y-2 text-white/70">
          {
            legalLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:text-accent transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="pt-8 border-t border-white/20 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-white/70">{displayedCopyright}</p>
      <div class="flex gap-6">
        {
          displayedSocialLinks.map((social) => (
            <a
              href={social.href}
              target={isExternalUrl(social.href) ? "_blank" : undefined}
              rel={
                isExternalUrl(social.href) ? "noopener noreferrer" : undefined
              }
              class="text-white/70 hover:opacity-100 opacity-70 transition-opacity"
              aria-label={social.label}
            >
              {social.label === 'LinkedIn' ? (
                <img src={LinkedInLogo.src} alt="LinkedIn" class="h-5 w-auto" />
              ) : (
                social.label
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
